{
    "name": "hellonico/image-factory",
    "type": "library",
    "authors": [
        {
            "name": "Nicolas Lemoine",
            "email": "dev@niconico.fr"
        }
    ],
    "require": {
        "php": "^8.0",
        "intervention/image": "^2.7",
        "loophp/phposinfo": "^1.7",
        "spatie/image": "^2.2",
        "symfony/filesystem": "^5.4 || ^6.0 || ^7.0",
        "symfony/mime": "^5.4 || ^6.0 || ^7.0",
        "symfony/process": "^5.4 || ^6.0 || ^7.0",
        "symfony/string": "^5.4 || ^6.0 || ^7.0",
        "twig/twig": "^2.4.4 || ^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.42",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.0",
        "symplify/easy-coding-standard": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "HelloNico\\ImageFactory\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HelloNico\\ImageFactory\\Test\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyze",
        "cs": "vendor/bin/ecs check src --fix",
        "cs:fix": "vendor/bin/ecs check src --fix",
        "test": "vendor/bin/phpunit --testdox --colors=always"
    }
}
